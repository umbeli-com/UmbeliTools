{
  "name": "@umbeli-com/tools",
  "version": "1.0.0",
  "description": "Typed client SDK for the UmbeliTools service — every node accessible from any Umbeli app",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/umbeli-com/UmbeliTools.git",
    "directory": "client"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
